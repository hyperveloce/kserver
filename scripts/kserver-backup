#!/bin/bash

echo "========================================"
echo " KServer manual backup"
echo " Started: $(date)"
echo "========================================"

echo
echo ">>> 1/3 Photos backup"
sudo /usr/local/bin/kserver.backup-photos.sh

if [ $? -ne 0 ]; then
    echo "!!! Photos backup FAILED"
    exit 1
fi

echo
echo ">>> 2/3 Storage Files backup"
sudo /usr/local/bin/kserver.backup-storage-files.sh

if [ $? -ne 0 ]; then
    echo "!!! Storage Files backup FAILED"
    exit 1
fi

echo
echo ">>> 3/3 NAS backup"
sudo /usr/local/bin/kserver.backup-to-nas.sh

if [ $? -ne 0 ]; then
    echo "!!! NAS backup FAILED"
    exit 1
fi

echo
echo "========================================"
echo " ALL BACKUPS COMPLETED SUCCESSFULLY"
echo " Finished: $(date)"
echo "========================================"
